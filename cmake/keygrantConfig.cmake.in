@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# A static keygrant is linked with what it uses; a shared one carries it.
if(@KEYGRANT_STATIC@)
  find_dependency(OpenSSL 3.0 COMPONENTS Crypto)
  find_dependency(CURL)
  find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/keygrantTargets.cmake")
check_required_components(keygrant)
